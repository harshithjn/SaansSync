# Server-only: used by the Next.js API proxy routes (app/api/**/route.ts) to
# reach the Render backend from the server side.
BACKEND_URL=https://your-backend.onrender.com

# Public: used by lib/api.ts for direct browser calls to the backend.
# Bare origin, no /api or /auth suffix — lib/api.ts appends those itself.
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
