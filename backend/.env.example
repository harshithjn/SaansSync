PORT=3001
NODE_ENV=production

# Neon connection string. Use the direct (non-pooled) connection string, not the
# PgBouncer-pooled one — this backend is a long-lived Render service, not a
# serverless function, so it manages its own persistent connection pool.
# Append ?sslmode=require if it isn't already part of the string Neon gives you.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/saanssync?sslmode=require

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Comma-separated list of origins allowed to call this API with credentials.
# Include your Vercel production domain and any preview domains you rely on.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
